generator client {
  provider = "prisma-client"
  output   = "../src/prismaORM/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cars {
  id                String               @id @default(uuid())
  carName           String
  carLicensePlate   String               @unique
  color             String
  brand             String
  carsRegistrations Cars_Registrations[]
}

model Drivers {
  id                String               @id @default(uuid())
  name              String               @unique
  carsRegistrations Cars_Registrations[]
}

model Cars_Registrations {
  id              String    @id @default(uuid())
  start_date      DateTime  @default(now())
  end_date        DateTime?
  driver_name     String
  driver          Drivers   @relation(fields: [driver_name], references: [name], onDelete: Cascade)
  car_name        String
  carLicensePlate String
  car             Cars      @relation(fields: [carLicensePlate], references: [carLicensePlate], onDelete: Cascade)
  reason_for_use  String
  createdAt       DateTime  @default(now())
}
