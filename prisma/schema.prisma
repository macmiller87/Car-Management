generator client {
  provider = "prisma-client"
  output   = "../src/prismaORM/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cars {
  id                String               @id @default(uuid())
  carName           String
  carLicensePlate   String               @unique
  color             String
  brand             String
  carsRegistrations Cars_Registrations[]
}

model Drivers {
  id                String               @id @default(uuid())
  name              String               @unique
  carsRegistrations Cars_Registrations[]
}

model Cars_Registrations {
  id             String   @id @default(uuid())
  start_date     DateTime @default(now())
  end_date       String   @default("")
  driver_name    String   @unique
  driver_id      String
  driver         Drivers  @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  car_name       String
  car_id         String
  car            Cars     @relation(fields: [car_id], references: [id], onDelete: Cascade)
  reason_for_use String
  createdAt      DateTime @default(now())
}
