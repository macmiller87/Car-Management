{
  "name": "Car-Management",
  "packageManager": "yarn@4.18.1",
  "author": "Macmiller Duarte de Andrade",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --env-file=.env --experimental-vm-modules $(yarn bin jest) --no-warnings --runInBand --forceExit --coverage",
    "dev:debug": "node --inspect --env-file=.env src/server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "setup:prisma": "npx prisma generate && npx prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2"
  }
}
