{
  "name": "Car-Management",
  "packageManager": "yarn@4.18.1",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "dev:debug": "node --inspect --env-file=.env src/server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "setup:prisma": "npx prisma generate && npx prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
